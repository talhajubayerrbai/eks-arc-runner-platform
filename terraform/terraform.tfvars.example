# Copy this file to terraform.tfvars and fill in the values.
# Never commit terraform.tfvars — it is in .gitignore.

aws_region   = "us-east-1"
project_name = "eks-arc-runner-platform"
environment  = "production"

# Networking
vpc_cidr             = "10.0.0.0/16"
availability_zones   = ["us-east-1a", "us-east-1b", "us-east-1c"]
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24", "10.0.3.0/24"]
private_subnet_cidrs = ["10.0.11.0/24", "10.0.12.0/24", "10.0.13.0/24"]

# EKS
kubernetes_version = "1.29"
node_instance_type = "t3.medium"
node_min_size      = 2
node_max_size      = 6
node_desired_size  = 3
ssh_key_name       = ""   # Leave blank for no SSH access

# GitHub (ARC)
github_owner = "talhajubayerrbai"
github_repo  = "eks-arc-runner-platform"

# GitHub App credentials — REQUIRED for ARC.
# Create a GitHub App with permissions: Actions (read), Administration (read/write).
# See docs/deployment-guide.md for step-by-step instructions.
github_app_id              = "YOUR_GITHUB_APP_ID"
github_app_installation_id = "YOUR_GITHUB_APP_INSTALLATION_ID"
github_app_private_key     = "YOUR_BASE64_ENCODED_PRIVATE_KEY_PEM"
